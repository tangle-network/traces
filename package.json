{
  "name": "@tangle-network/traces",
  "version": "1.0.0",
  "description": "What your coding agents did, where they wasted time, and whether a run passes: exact facts, ranked findings, one CI gate and a live view over Claude Code, Codex, OpenCode, Pi, Kimi and Factory sessions and any OTLP spans. CLI and SDK.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tangle-network/traces.git"
  },
  "homepage": "https://github.com/tangle-network/traces#readme",
  "bugs": "https://github.com/tangle-network/traces/issues",
  "keywords": [
    "ai-agents",
    "observability",
    "tracing",
    "otlp",
    "claude-code",
    "codex",
    "opencode",
    "agent-eval",
    "llm",
    "coding-agent"
  ],
  "packageManager": "pnpm@10.33.4",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./skills/*": "./skills/*"
  },
  "bin": {
    "traces": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "skills",
    "install.sh",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "bench:audit": "tsx bench/audit/cli.ts",
    "bench:corrections": "tsx bench/corrections/score.ts",
    "bench:parity": "tsx bench/parity/score.ts",
    "build": "tsup",
    "check:package": "node scripts/check-package-bin.mjs",
    "check:source": "node scripts/check-source-text.mjs",
    "prepare": "node scripts/check-source-text.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify:contracts-corpus": "tsx tests/contracts-corpus/verify.mjs",
    "prepublishOnly": "pnpm check:source && pnpm build && pnpm check:package"
  },
  "dependencies": {
    "@tangle-network/agent-eval": "0.221.3",
    "@tangle-network/agent-interface": "5.7.1",
    "@tangle-network/agent-runtime": "0.348.1",
    "@tangle-network/agent-trace-contract": "2.1.0",
    "@tangle-network/harness-sessions": "0.1.7",
    "@tangle-network/sandbox": "0.64.39"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "postcss": "^8.5.28",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
